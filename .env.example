APP_ENVIRONMENT=local
APP_PUBLIC_BASE_URL=https://your-project.vercel.app

DATABASE_URL=postgresql://olx:olx@localhost:5432/olx_bot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_PGBOUNCER_MODE=false

TELEGRAM_BOT_TOKEN=123456:replace-with-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=replace-with-random-string-of-letters-digits-underscore-dash
TELEGRAM_THROTTLE_SECONDS=1.0
TELEGRAM_REQUEST_TIMEOUT_SECONDS=15

CRON_SECRET=replace-with-long-random-string
CRON_TIME_BUDGET_SECONDS=250
CRON_CONCURRENCY=5
CRON_CLAIM_LEASE_SECONDS=600
CRON_TASK_GRACE_SECONDS=25

FILTER_DEFAULT_LIMIT=10
FILTER_CHECK_INTERVAL_SECONDS=0
FILTER_MAX_ADVERT_AGE_HOURS=48
FILTER_MAX_NOTIFICATIONS_PER_CHECK=20
FILTER_PAUSE_AFTER_MISSING_CHECKS=5
FILTER_RETRY_BASE_DELAY_SECONDS=60
FILTER_RETRY_MAX_DELAY_SECONDS=3600
FILTER_SEEN_RETENTION_DAYS=14

OLX_REQUEST_TIMEOUT_SECONDS=15
OLX_CONNECT_TIMEOUT_SECONDS=5
OLX_TOTAL_TIMEOUT_SECONDS=25
OLX_MAX_RESPONSE_BYTES=5000000
OLX_MAX_REDIRECTS=3
OLX_MAX_CONCURRENT_REQUESTS=5

LOG_LEVEL=INFO
LOG_FORMAT=json
